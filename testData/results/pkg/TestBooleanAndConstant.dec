package pkg;

public class TestBooleanAndConstant {
   boolean flag;

   boolean check(int i) {
      return i > 2;// 9
   }

   public void testInvocation(int a, int b) {
      boolean ok = true & this.check(a);// 13
      int c = a << 8 | b;// 14
      ok &= this.check(c);// 15
      if (ok) {// 16
         System.out.println(c);// 19
      }
   }// 17 20

   public boolean testField() {
      return true & this.flag;// 23
   }

   public int testInt(int a) {
      return 1 & a;// 27
   }
}

