package pkg;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
import java.util.Set;

public class TestRawIterableForeach {
   List<Object> objects = new ArrayList<>();

   public void testRawClass(TestRawIterableForeach.Bag bag) {
      for (String s : (Iterable<String>)bag) {// 26 28
         System.out.println(s.length());// 29
      }
   }// 31

   public void testRawList(List list) {
      for (String s : (Iterable<String>)list) {// 34 36
         System.out.println(s.length());// 37
      }
   }// 39

   public int testRawUnboxing(Set set) {
      int sum = 0;// 42

      for (int i : (Iterable<Integer>)set) {// 43 45
         sum += i;// 46
      }

      return sum;// 48
   }

   public void testObjectList() {
      for (String s : (Iterable<String>)(Iterable)this.objects) {// 54 56
         System.out.println(s.length());// 57
      }
   }// 59

   public void testGenericList(List<String> list) {
      for (String s : list) {// 63
         System.out.println(s.length());// 64
      }
   }// 66

   public void testRawObject(List list) {
      for (Object o : list) {// 69
         System.out.println(o);// 70
      }
   }// 72

   public void testParameterizedClass(TestRawIterableForeach.Names names) {
      for (String s : names) {// 75
         System.out.println(s.length());// 76
      }
   }// 78

   static class Bag implements Iterable {
      final List items = new ArrayList();

      @Override
      public Iterator iterator() {
         return this.items.iterator();// 15
      }
   }

   static class Names implements Iterable<String> {
      @Override
      public Iterator<String> iterator() {
         return null;// 21
      }
   }
}

